@model QuanLyKhoaHoc.Models.TaiKhoan
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="card col-md-8 mx-auto">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">Chỉnh sửa tài khoản #@Model.MaTaiKhoan</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaTaiKhoan" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label fw-semibold"></label>
                <input asp-for="TenDangNhap" class="form-control" />
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label fw-semibold"></label>
                <input asp-for="MatKhau" class="form-control" />
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HoTen" class="form-label fw-semibold"></label>
                <input asp-for="HoTen" class="form-control" />
                <span asp-validation-for="HoTen" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="VaiTro" class="form-label fw-semibold"></label>
                <select asp-for="VaiTro" class="form-select">
                    <option value="Admin">Admin</option>
                    <option value="NhanVien">Nhân viên</option>
                    <option value="HocVien">Học viên</option>
                </select>
            </div>
            <div class="form-check mb-3">
                <input asp-for="TrangThai" class="form-check-input" />
                <label asp-for="TrangThai" class="form-check-label"></label>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                <button type="submit" class="btn btn-primary">Cập nhật</button>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }