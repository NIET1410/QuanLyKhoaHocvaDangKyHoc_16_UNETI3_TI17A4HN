@model IEnumerable<QuanLyKhoaHoc.Models.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-shield-lock text-primary me-2"></i>Quản lý Tài khoản Hệ thống</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm tài khoản</a>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên đăng nhập, họ tên, email..." />
        </div>
        <div class="col-md-4">
            <select name="vaiTro" class="form-select">
                <option value="">-- Tất cả vai trò --</option>
                <option value="Admin" selected="@(ViewBag.VaiTro == "Admin")">Admin</option>
                <option value="NhanVien" selected="@(ViewBag.VaiTro == "NhanVien")">Nhân viên</option>
                <option value="HocVien" selected="@(ViewBag.VaiTro == "HocVien")">Học viên</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã TK</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.MaTaiKhoan</td>
                        <td class="fw-semibold">@item.TenDangNhap</td>
                        <td>@item.HoTen</td>
                        <td>@item.Email</td>
                        <td>
                            @if (item.VaiTro == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else if (item.VaiTro == "NhanVien")
                            {
                                <span class="badge bg-primary">Nhân viên</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Học viên</span>
                            }
                        </td>
                        <td>
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-dark">Đã khóa</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.MaTaiKhoan" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(item.TrangThai ? "btn-outline-danger" : "btn-outline-success")">
                                    @(item.TrangThai ? "Khóa" : "Mở khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>