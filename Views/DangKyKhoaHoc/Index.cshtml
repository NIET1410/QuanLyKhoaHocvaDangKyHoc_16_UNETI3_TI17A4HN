@model QuanLyKhoaHoc.ViewModels.DangKyFilterViewModel
@{
    ViewData["Title"] = "Tiếp nhận & Xử lý Đăng ký";
}

<h4 class="fw-bold mb-3"><i class="bi bi-clipboard-check text-primary me-2"></i>Tiếp nhận & Xử lý Hồ sơ Đăng ký Khóa học</h4>

<form method="get" class="card card-body mb-3 shadow-sm">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Tìm học viên</label>
            <input name="timHocVien" value="@Model.TimHocVien" class="form-control form-control-sm" placeholder="Tên hoặc SĐT học viên..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Tìm khóa học</label>
            <input name="timKhoaHoc" value="@Model.TimKhoaHoc" class="form-control form-control-sm" placeholder="Tên khóa học..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Môn học</label>
            <select name="maMonHoc" asp-items="@ViewBag.MonHocs" class="form-select form-select-sm">
                <option value="">-- Tất cả môn --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Trạng thái</label>
            <select name="trangThai" class="form-select form-select-sm">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Chờ xử lý" selected="@(Model.TrangThai == "Chờ xử lý")">Chờ xử lý</option>
                <option value="Đang xử lý" selected="@(Model.TrangThai == "Đang xử lý")">Đang xử lý</option>
                <option value="Hoàn thành" selected="@(Model.TrangThai == "Hoàn thành")">Hoàn thành</option>
                <option value="Hủy" selected="@(Model.TrangThai == "Hủy")">Hủy</option>
                <option value="Từ chối" selected="@(Model.TrangThai == "Từ chối")">Từ chối</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Từ ngày</label>
            <input name="tuNgay" type="date" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Đến ngày</label>
            <input name="denNgay" type="date" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Sắp xếp</label>
            <select name="sapXep" class="form-select form-select-sm">
                <option value="moi_nhat" selected="@(Model.SapXep == "moi_nhat")">Mới đăng ký nhất</option>
                <option value="cu_nhat" selected="@(Model.SapXep == "cu_nhat")">Cũ nhất trước</option>
                <option value="hocvien_az" selected="@(Model.SapXep == "hocvien_az")">Tên học viên A-Z</option>
                <option value="congno_giam" selected="@(Model.SapXep == "congno_giam")">Công nợ cao -> thấp</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">Lọc hồ sơ</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Đặt lại</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã ĐK</th>
                    <th>Học viên</th>
                    <th>Khóa học</th>
                    <th>Ngày ĐK</th>
                    <th>Đã đóng</th>
                    <th>Còn nợ</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Xử lý</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.DanhSachDangKy)
                {
                    string badge = item.TrangThai switch
                    {
                        "Chờ xử lý" => "bg-warning text-dark",
                        "Đang xử lý" => "bg-info text-dark",
                        "Hoàn thành" => "bg-success",
                        "Hủy" => "bg-secondary",
                        "Từ chối" => "bg-danger",
                        _ => "bg-dark"
                    };
                    <tr>
                        <td>#@item.MaDangKy</td>
                        <td>
                            <div class="fw-semibold">@item.HocVien?.HoTen</div>
                            <small class="text-muted">@item.HocVien?.SoDienThoai</small>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.KhoaHoc?.TenKhoaHoc</div>
                            <small class="text-muted">@item.KhoaHoc?.MonHoc?.TenMonHoc</small>
                        </td>
                        <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-success fw-semibold">@item.SoTienDaDong.ToString("N0") đ</td>
                        <td class="text-danger fw-semibold">@item.SoTienConLai.ToString("N0") đ</td>
                        <td><span class="badge @badge">@item.TrangThai</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.MaDangKy" class="btn btn-sm btn-primary">
                                Xử lý hồ sơ
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>