@model IEnumerable<QuanLyKhoaHoc.Models.DangKyKhoaHoc>
@{
    ViewData["Title"] = "Đăng ký khóa học của tôi";
}

<h4 class="fw-bold mb-3"><i class="bi bi-card-checklist text-primary me-2"></i>Danh sách Khóa học Tôi Đã Đăng ký</h4>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã ĐK</th>
                    <th>Khóa học</th>
                    <th>Ngày đăng ký</th>
                    <th>Đã đóng</th>
                    <th>Còn nợ</th>
                    <th>Trạng thái xử lý</th>
                    <th>Ghi chú</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string badge = item.TrangThai switch
                    {
                        "Chờ xử lý" => "bg-warning text-dark",
                        "Đang xử lý" => "bg-info text-dark",
                        "Hoàn thành" => "bg-success",
                        "Hủy" => "bg-secondary",
                        "Từ chối" => "bg-danger",
                        _ => "bg-dark"
                    };
                    <tr>
                        <td>#@item.MaDangKy</td>
                        <td>
                            <div class="fw-semibold">@item.KhoaHoc?.TenKhoaHoc</div>
                            <small class="text-muted">GV: @item.KhoaHoc?.GiangVien?.HoTen | Khai giảng: @item.KhoaHoc?.NgayBatDau.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-success fw-semibold">@item.SoTienDaDong.ToString("N0") đ</td>
                        <td class="text-danger fw-semibold">@item.SoTienConLai.ToString("N0") đ</td>
                        <td><span class="badge @badge">@item.TrangThai</span></td>
                        <td class="small text-muted">@item.GhiChu</td>
                        <td class="text-end">
                            @if (item.TrangThai == "Chờ xử lý")
                            {
                                <form asp-action="CancelMyRegistration" method="post" class="d-inline" onsubmit="return confirm('Bạn muốn hủy đăng ký khóa học này?');">
                                    <input type="hidden" name="maDangKy" value="@item.MaDangKy" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy ĐK</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>