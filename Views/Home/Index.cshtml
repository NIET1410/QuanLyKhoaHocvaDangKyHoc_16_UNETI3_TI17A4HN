@* Họ và tên: Nguyễn Duy Trung *@
@* Mã sinh viên: 23103100256 *@
@* Nội dung thực hiện: Giao diện Trang chủ (Banner, Thống kê nhanh, Khóa học đang mở, Môn học) *@

@model IEnumerable<QuanLyKhoaHoc.Models.KhoaHoc>
@{
    ViewData["Title"] = "Trang chủ";
    var monHocs = ViewBag.DanhSachMonHoc as IEnumerable<QuanLyKhoaHoc.Models.MonHoc>;
}

<!-- BANNER GIỚI THIỆU -->
<div class="p-5 mb-4 bg-primary text-white rounded-3 shadow-sm">
    <div class="container-fluid py-2">
        <h1 class="display-6 fw-bold">HỆ THỐNG QUẢN LÝ KHÓA HỌC & ĐĂNG KÝ HỌC TRỰC TUYẾN</h1>
        <p class="col-md-9 fs-5 mt-2">
            Nền tảng đào tạo Công nghệ thông tin chất lượng cao. Tra cứu lịch khai giảng, đăng ký khóa học nhanh chóng và theo dõi kết quả học tập trực tuyến.
        </p>
        <div class="d-flex flex-wrap gap-3 mt-4">
            <a asp-controller="KhoaHoc" asp-action="Index" class="btn btn-warning btn-lg fw-bold px-4">
                <i class="bi bi-search me-2"></i>Xem khóa học ngay
            </a>
            <div class="d-flex align-items-center bg-white text-dark px-3 py-2 rounded">
                <i class="bi bi-easel2-fill text-primary fs-4 me-2"></i>
                <div>
                    <div class="fw-bold">@ViewBag.TongKhoaHoc Khóa học</div>
                    <small class="text-muted">@ViewBag.TongMonHoc chuyên đề đào tạo</small>
                </div>
            </div>
            <div class="d-flex align-items-center bg-white text-dark px-3 py-2 rounded">
                <i class="bi bi-people-fill text-success fs-4 me-2"></i>
                <div>
                    <div class="fw-bold">@ViewBag.TongHocVien Học viên</div>
                    <small class="text-muted">Đang theo học tại trung tâm</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DANH SÁCH KHÓA HỌC ĐANG MỞ NỔI BẬT -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-dark mb-0"><i class="bi bi-fire text-danger me-2"></i>Khóa học đang mở đăng ký</h3>
    <a asp-controller="KhoaHoc" asp-action="Index" class="btn btn-outline-primary btn-sm">
        Xem tất cả khóa học <i class="bi bi-arrow-right ms-1"></i>
    </a>
</div>

<div class="row g-4 mb-5">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-info text-dark">@item.HinhThuc</span>
                        <span class="badge bg-success">@item.TrangThai</span>
                    </div>
                    <h5 class="card-title fw-bold text-primary">@item.TenKhoaHoc</h5>
                    <p class="text-muted small mb-2">
                        <i class="bi bi-book me-1"></i><strong>Môn học:</strong> @item.MonHoc?.TenMonHoc
                    </p>
                    <p class="text-muted small mb-2">
                        <i class="bi bi-person-badge me-1"></i><strong>Giảng viên:</strong> @item.GiangVien?.HoTen
                    </p>
                    <p class="text-muted small mb-2">
                        <i class="bi bi-calendar-event me-1"></i><strong>Khai giảng:</strong> @item.NgayBatDau.ToString("dd/MM/yyyy") - @item.NgayKetThuc.ToString("dd/MM/yyyy")
                    </p>
                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-danger fw-bold fs-5">@item.HocPhi.ToString("N0") đ</span>
                            <div class="small text-secondary">Còn nhận: <strong>@item.SoChoConLai / @item.SoLuongToiDa</strong> chỗ</div>
                        </div>
                        <div class="d-flex gap-1">
                            <a asp-controller="KhoaHoc" asp-action="Details" asp-route-id="@item.MaKhoaHoc" class="btn btn-outline-secondary btn-sm">Chi tiết</a>
                            <a asp-controller="DangKyKhoaHoc" asp-action="Confirm" asp-route-maKhoaHoc="@item.MaKhoaHoc" class="btn btn-primary btn-sm">Đăng ký</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- DANH SÁCH CÁC MÔN HỌC CHUYÊN ĐỀ -->
<h3 class="fw-bold text-dark mb-3"><i class="bi bi-collection-play text-primary me-2"></i>Các môn học đào tạo</h3>
<div class="row g-3">
    @if (monHocs != null)
    {
        foreach (var mh in monHocs)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="fw-bold">@mh.TenMonHoc</h5>
                        <div class="mb-2">
                            <span class="badge bg-secondary me-2">@mh.SoTinChi Tín chỉ</span>
                            <span class="badge bg-light text-dark border">Học phí chuẩn: @mh.HocPhi.ToString("N0") đ</span>
                        </div>
                        <p class="text-muted small mb-3">@mh.MoTa</p>
                        <a asp-controller="KhoaHoc" asp-action="Index" asp-route-maMonHoc="@mh.MaMonHoc" class="btn btn-sm btn-outline-primary">
                            Xem @(mh.KhoaHocs?.Count ?? 0) khóa học của môn này
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>