@* Họ và tên: Tạ Xuân Thưng - 23103100286 *@
@model QuanLyKhoaHoc.Models.HocVien
@{
    ViewData["Title"] = "Hồ sơ cá nhân của tôi";
}

<div class="card col-md-8 mx-auto shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-person-vcard text-primary me-2"></i>Hồ sơ Học viên Cá nhân (#@Model.MaHocVien)</h5>
    </div>
    <div class="card-body">
        <form asp-action="Profile" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label fw-semibold"></label>
                    <input asp-for="HoTen" class="form-control" required />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NgaySinh" class="form-label fw-semibold"></label>
                    <input asp-for="NgaySinh" type="date" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="GioiTinh" class="form-label fw-semibold"></label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                    <input asp-for="SoDienThoai" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="TrinhDo" class="form-label fw-semibold"></label>
                    <input asp-for="TrinhDo" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="DiaChi" class="form-label fw-semibold"></label>
                    <input asp-for="DiaChi" class="form-control" />
                </div>
            </div>
            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i>Lưu hồ sơ cá nhân
                </button>
            </div>
        </form>
    </div>
</div>