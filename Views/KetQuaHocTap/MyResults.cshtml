@model IEnumerable<QuanLyKhoaHoc.Models.KetQuaHocTap>
@{
    ViewData["Title"] = "Kết quả học tập của tôi";
}

<h4 class="fw-bold mb-3"><i class="bi bi-award text-primary me-2"></i>Bảng điểm & Kết quả Học tập Cá nhân</h4>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Khóa học</th>
                    <th>Môn học</th>
                    <th>Chuyên cần (10%)</th>
                    <th>Giữa kỳ (30%)</th>
                    <th>Cuối kỳ (60%)</th>
                    <th>Điểm tổng kết</th>
                    <th>Xếp loại</th>
                    <th>Kết quả</th>
                    <th>Ngày cập nhật</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.DangKyKhoaHoc?.KhoaHoc?.TenKhoaHoc</td>
                        <td>@item.DangKyKhoaHoc?.KhoaHoc?.MonHoc?.TenMonHoc</td>
                        <td>@item.DiemChuyenCan</td>
                        <td>@item.DiemGiuaKy</td>
                        <td>@item.DiemCuoiKy</td>
                        <td class="fw-bold text-primary fs-5">@item.DiemTongKet.ToString("0.00")</td>
                        <td><span class="badge bg-info text-dark">@item.XepLoai</span></td>
                        <td>
                            <span class="badge @(item.KetQua == "Đạt" ? "bg-success" : "bg-danger")">@item.KetQua</span>
                        </td>
                        <td>@item.NgayCapNhat.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>