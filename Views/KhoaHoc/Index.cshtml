@* Họ và tên: Phan Anh Tú *@
@* Mã sinh viên: 23103100258 *@
@* Nội dung thực hiện: Module 2 - Giao diện Danh sách Khóa học (Search + Filter + Sort + Pagination) *@

@model QuanLyKhoaHoc.ViewModels.KhoaHocFilterViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Danh sách Khóa học";
    var vaiTro = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro");
    bool isStaffOrAdmin = (vaiTro == "Admin" || vaiTro == "NhanVien");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-easel2 text-primary me-2"></i>Danh sách Khóa học</h4>
        <small class="text-muted">Tìm thấy <strong>@Model.TongSoBanGhi</strong> khóa học phù hợp</small>
    </div>
    @if (isStaffOrAdmin)
    {
        <a asp-action="Create" class="btn btn-primary fw-semibold">
            <i class="bi bi-plus-circle me-1"></i>Mở khóa học mới
        </a>
    }
</div>

<!-- FORM TÌM KIẾM + LỌC + SẮP XẾP -->
<form asp-action="Index" method="get" class="card card-body mb-4 shadow-sm">
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small fw-semibold mb-1">Từ khóa (Khóa học / Môn học / Giảng viên)</label>
            <input name="tuKhoa" value="@Model.TuKhoa" class="form-control form-control-sm" placeholder="Nhập từ khóa tìm kiếm..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Môn học</label>
            <select name="maMonHoc" asp-items="@ViewBag.MonHocs" class="form-select form-select-sm">
                <option value="">-- Tất cả môn học --</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold mb-1">Hình thức</label>
            <select name="hinhThuc" class="form-select form-select-sm">
                <option value="">-- Tất cả --</option>
                <option value="Offline" selected="@(Model.HinhThuc == "Offline")">Offline</option>
                <option value="Online" selected="@(Model.HinhThuc == "Online")">Online</option>
                <option value="Hybrid" selected="@(Model.HinhThuc == "Hybrid")">Hybrid</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Trạng thái khóa học</label>
            <select name="trangThai" class="form-select form-select-sm">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Đang mở" selected="@(Model.TrangThai == "Đang mở")">Đang mở</option>
                <option value="Chưa mở" selected="@(Model.TrangThai == "Chưa mở")">Chưa mở</option>
                <option value="Đã đầy" selected="@(Model.TrangThai == "Đã đầy")">Đã đầy</option>
                <option value="Đang học" selected="@(Model.TrangThai == "Đang học")">Đang học</option>
                <option value="Đã kết thúc" selected="@(Model.TrangThai == "Đã kết thúc")">Đã kết thúc</option>
                <option value="Đã hủy" selected="@(Model.TrangThai == "Đã hủy")">Đã hủy</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small fw-semibold mb-1">Học phí từ (VNĐ)</label>
            <input name="hocPhiTu" type="number" step="100000" value="@Model.HocPhiTu" class="form-control form-control-sm" placeholder="0" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold mb-1">Đến (VNĐ)</label>
            <input name="hocPhiDen" type="number" step="100000" value="@Model.HocPhiDen" class="form-control form-control-sm" placeholder="10,000,000" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold mb-1">Tình trạng chỗ</label>
            <select name="tinhTrangCho" class="form-select form-select-sm">
                <option value="">-- Tất cả --</option>
                <option value="ConCho" selected="@(Model.TinhTrangCho == "ConCho")">Còn chỗ</option>
                <option value="HetCho" selected="@(Model.TinhTrangCho == "HetCho")">Hết chỗ</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Sắp xếp theo</label>
            <select name="sapXep" class="form-select form-select-sm">
                <option value="ngay_tang" selected="@(Model.SapXep == "ngay_tang")">Ngày bắt đầu tăng dần</option>
                <option value="ngay_giam" selected="@(Model.SapXep == "ngay_giam")">Ngày bắt đầu giảm dần</option>
                <option value="ten_az" selected="@(Model.SapXep == "ten_az")">Tên khóa học A -> Z</option>
                <option value="ten_za" selected="@(Model.SapXep == "ten_za")">Tên khóa học Z -> A</option>
                <option value="hocphi_tang" selected="@(Model.SapXep == "hocphi_tang")">Học phí thấp -> cao</option>
                <option value="hocphi_giam" selected="@(Model.SapXep == "hocphi_giam")">Học phí cao -> thấp</option>
                <option value="cho_tang" selected="@(Model.SapXep == "cho_tang")">Số chỗ còn lại tăng dần</option>
                <option value="cho_giam" selected="@(Model.SapXep == "cho_giam")">Số chỗ còn lại giảm dần</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                <i class="bi bi-funnel me-1"></i>Áp dụng lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Đặt lại</a>
        </div>
    </div>
</form>

<!-- HIỂN THỊ DANH SÁCH KHÓA HỌC DẠNG CARD KẾT HỢP BADGE -->
@if (!Model.DanhSachKhoaHoc.Any())
{
    <div class="alert alert-warning text-center py-4">
        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
        Không tìm thấy khóa học nào khớp với điều kiện tìm kiếm và bộ lọc của bạn.
    </div>
}
else
{
    <div class="row g-4 mb-4">
        @foreach (var item in Model.DanhSachKhoaHoc)
        {
            string badgeClass = item.TrangThai switch
            {
                "Đang mở" => "bg-success",
                "Chưa mở" => "bg-info text-dark",
                "Đã đầy" => "bg-warning text-dark",
                "Đang học" => "bg-primary",
                "Đã kết thúc" => "bg-secondary",
                "Đã hủy" => "bg-danger",
                _ => "bg-dark"
            };

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-light text-dark border"><i class="bi bi-laptop me-1"></i>@item.HinhThuc</span>
                            <span class="badge @badgeClass">@item.TrangThai</span>
                        </div>

                        <h5 class="card-title fw-bold text-primary">@item.TenKhoaHoc</h5>
                        <p class="small text-muted mb-1"><i class="bi bi-book me-1"></i><strong>Môn học:</strong> @item.MonHoc?.TenMonHoc</p>
                        <p class="small text-muted mb-1"><i class="bi bi-person-workspace me-1"></i><strong>Giảng viên:</strong> @item.GiangVien?.HoTen</p>
                        <p class="small text-muted mb-1">
                            <i class="bi bi-calendar3 me-1"></i><strong>Thời gian:</strong> @item.NgayBatDau.ToString("dd/MM/yyyy") - @item.NgayKetThuc.ToString("dd/MM/yyyy")
                        </p>
                        <p class="small mb-2">
                            <i class="bi bi-people me-1"></i><strong>Chỗ trống:</strong>
                            @if (item.SoChoConLai > 0)
                            {
                                <span class="text-success fw-bold">Còn @item.SoChoConLai / @item.SoLuongToiDa chỗ</span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">Hết chỗ (0 / @item.SoLuongToiDa)</span>
                            }
                        </p>

                        <div class="mt-auto pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Học phí khóa học:</span>
                                <span class="text-danger fw-bold fs-5">@item.HocPhi.ToString("N0") VNĐ</span>
                            </div>

                            <div class="d-flex justify-content-between gap-1">
                                <a asp-action="Details" asp-route-id="@item.MaKhoaHoc" class="btn btn-outline-primary btn-sm flex-grow-1">
                                    <i class="bi bi-eye me-1"></i>Chi tiết
                                </a>

                                @if (item.TrangThai == "Đang mở" && item.SoChoConLai > 0 && !isStaffOrAdmin)
                                {
                                    <a asp-controller="DangKyKhoaHoc" asp-action="Confirm" asp-route-maKhoaHoc="@item.MaKhoaHoc" class="btn btn-success btn-sm flex-grow-1">
                                        <i class="bi bi-check2-circle me-1"></i>Đăng ký
                                    </a>
                                }

                                @if (isStaffOrAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.MaKhoaHoc" class="btn btn-outline-secondary btn-sm">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.MaKhoaHoc" class="btn btn-outline-danger btn-sm">Xóa</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- THANH PHÂN TRANG GIỮ NGUYÊN TOÀN BỘ THAM SỐ SEARCH + FILTER + SORT -->
    @if (Model.TongSoTrang > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.TrangHienTai == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-tuKhoa="@Model.TuKhoa"
                       asp-route-maMonHoc="@Model.MaMonHoc"
                       asp-route-hinhThuc="@Model.HinhThuc"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-hocPhiTu="@Model.HocPhiTu"
                       asp-route-hocPhiDen="@Model.HocPhiDen"
                       asp-route-tinhTrangCho="@Model.TinhTrangCho"
                       asp-route-sapXep="@Model.SapXep"
                       asp-route-page="@(Model.TrangHienTai - 1)">
                        &laquo; Trang trước
                    </a>
                </li>

                @for (int i = 1; i <= Model.TongSoTrang; i++)
                {
                    <li class="page-item @(i == Model.TrangHienTai ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-tuKhoa="@Model.TuKhoa"
                           asp-route-maMonHoc="@Model.MaMonHoc"
                           asp-route-hinhThuc="@Model.HinhThuc"
                           asp-route-trangThai="@Model.TrangThai"
                           asp-route-hocPhiTu="@Model.HocPhiTu"
                           asp-route-hocPhiDen="@Model.HocPhiDen"
                           asp-route-tinhTrangCho="@Model.TinhTrangCho"
                           asp-route-sapXep="@Model.SapXep"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.TrangHienTai == Model.TongSoTrang ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-tuKhoa="@Model.TuKhoa"
                       asp-route-maMonHoc="@Model.MaMonHoc"
                       asp-route-hinhThuc="@Model.HinhThuc"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-hocPhiTu="@Model.HocPhiTu"
                       asp-route-hocPhiDen="@Model.HocPhiDen"
                       asp-route-tinhTrangCho="@Model.TinhTrangCho"
                       asp-route-sapXep="@Model.SapXep"
                       asp-route-page="@(Model.TrangHienTai + 1)">
                        Trang sau &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }
}